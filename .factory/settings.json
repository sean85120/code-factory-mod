{
  "baseBranch": "main",
  "testCmd": ["bash", "-lc", "claude plugin test . && node --experimental-strip-types --test core/*.spec.ts codex/*.spec.ts opencode/*.spec.ts && scripts/check-version.sh"],
  "buildCmd": ["bash", "-lc", "opencode/node_modules/.bin/tsc -p . && npx --prefix opencode tsc -p opencode"],
  "e2eFor": ["feature", "bug"],
  "testTimeoutMs": 600000,
  "mergeMethod": "squash",
  "maxAttempts": 4,
  "maxItemsPerRun": 0,
  "allowNoCI": false,
  "requireTestChanges": true,
  "requireReview": true,
  "reviewCommand": "/review-fix",
  "maxReviewRounds": 3,
  "contextReset": "clear",
  "stopAfterVersion": "0.4.10",
  "tagRelease": false,
  "requireBranchProtection": false,
  "allowTestRemoval": false,
  "reviewTimeoutMs": 1800000,
  "budgetUsd": 0,
  "askNextPhase": true,
  "watchIssues": false,
  "buildFromLabels": false
}
